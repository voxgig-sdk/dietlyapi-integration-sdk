  id: {
    field: "id"
    name: "id"
  }

  name: "food"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/foods/categories"
          parts: [
            "foods"
            "categories"
          ]
          select: {
            "$action": "category"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 1068319
                kind: "param"
                name: "id"
                orig: "food_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/food/{food_id}"
          parts: [
            "food"
            "{id}"
          ]
          rename: {
            param: {
              food_id: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
