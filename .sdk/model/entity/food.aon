# Entity: food

main: kit: entity: food: {

  alias: field: {}

  fields: [
    {
      name: "barcode"
      req: false
      type: "`$STRING`"
    }
    {
      name: "brand"
      req: false
      type: "`$STRING`"
    }
    {
      name: "calories_kcal"
      req: false
      short: "Energy in kcal per 100 g"
      type: "`$NUMBER`"
    }
    {
      name: "carbs_g"
      req: false
      short: "Carbohydrate in grams per 100 g"
      type: "`$NUMBER`"
    }
    {
      name: "category"
      req: false
      type: "`$STRING`"
    }
    {
      name: "cholesterol_mg"
      req: false
      short: "Cholesterol in mg per 100 g"
      type: "`$NUMBER`"
    }
    {
      name: "confidence"
      req: false
      short: "Data confidence score, 0–1"
      type: "`$NUMBER`"
    }
    {
      name: "count"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "fat_g"
      req: false
      short: "Total fat in grams per 100 g"
      type: "`$NUMBER`"
    }
    {
      name: "fiber_g"
      req: false
      short: "Fibre in grams per 100 g"
      type: "`$NUMBER`"
    }
    {
      name: "id"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "image_thumb_url"
      req: false
      type: "`$STRING`"
    }
    {
      name: "image_url"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "potassium_mg"
      req: false
      short: "Potassium in mg per 100 g"
      type: "`$NUMBER`"
    }
    {
      name: "protein_g"
      req: false
      short: "Protein in grams per 100 g"
      type: "`$NUMBER`"
    }
    {
      name: "saturated_fat_g"
      req: false
      short: "Saturated fat in grams per 100 g"
      type: "`$NUMBER`"
    }
    {
      name: "serving_desc"
      req: false
      short: "Human-readable label for one serving, e.g."
      type: "`$STRING`"
    }
    {
      name: "serving_size_g"
      req: false
      short: "Grams in one manufacturer serving, where the source declares one."
      type: "`$NUMBER`"
    }
    {
      name: "sodium_mg"
      req: false
      short: "Sodium in mg per 100 g"
      type: "`$NUMBER`"
    }
    {
      name: "source"
      req: false
      short: "Data source: off (Open Food Facts), usda (USDA FoodData Central), claude (labeled AI estimate) or community"
      type: "`$STRING`"
    }
    {
      name: "static_url"
      req: false
      short: "Path of the human-readable page on www.getdietly.com"
      type: "`$STRING`"
    }
    {
      name: "sugar_g"
      req: false
      short: "Sugars in grams per 100 g"
      type: "`$NUMBER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "food"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/foods/categories"
          segments: [
            {
              lit: "foods"
            }
            {
              lit: "categories"
            }
          ]
          select: {
            "$action": "category"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 1068319
                kind: "param"
                name: "id"
                orig: "food_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/food/{food_id}"
          rename: {
            param: {
              food_id: "id"
            }
          }
          segments: [
            {
              lit: "food"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
