# Guide

guide: {
  metrics: count: entity: 5
  metrics: count: path: 6
  metrics: count: method: 6

  entity: barcode: {
    path: "/barcode/{code}": {
      rename: param: "code": *"id"
      op: load: method: *GET
    }
  }

  entity: food: {
    path: "/food/{food_id}": {
      rename: param: "food_id": *"id"
      op: load: method: *GET
    }
    path: "/foods/categories": {
      action: "category": {}
      op: list: method: *GET
    }
  }

  entity: meta: {
    path: "/health": {
      op: load: method: *GET
    }
  }

  entity: popular: {
    path: "/foods/popular": {
      op: list: method: *GET
    }
  }

  entity: search: {
    path: "/search": {
      op: list: method: *GET
    }
  }

}