      "info": {
        "contact": {
          "name": "DietlyAPI support",
          "url": "https://www.getdietly.com/support?topic=api"
        },
        "description": "DietlyAPI is a food and nutrition API providing access to 4.7M+ indexed foods from a worldwide catalog. It offers fuzzy food search, EAN/UPC barcode lookup, stable food IDs, normalized nutrition fields and confidence-aware ranking.\n\nDietlyAPI is built primarily on Open Food Facts data under ODbL, with Dietly normalization, indexing, plausibility checks and scheduled daily updates. Applications displaying applicable data must provide the required Open Food Facts attribution.\n\nPublic food-read endpoints can be tested without authentication. Anonymous and Starter traffic uses shared per-IP limits and a configured fairness delay. Paid plans provide account-level limits and skip that delay. Pricing, documentation and uptime history are publicly available at https://www.getdietly.com/api, https://www.getdietly.com/api-guide and https://www.getdietly.com/uptime.",
        "license": {
          "name": "ODbL 1.0 (underlying Open Food Facts data)",
          "url": "https://opendatacommons.org/licenses/odbl/1-0/"
        },
        "meta_source": "https://www.freepublicapis.com",
        "security": {
          "in": "header",
          "name": "Authorization",
          "prefix": "Bearer",
          "scheme": "bearerAuth",
          "type": "http"
        },
        "servers": [
          {
            "description": "Production (EU)",
            "url": "https://api.getdietly.com"
          }
        ],
        "summary": "DietlyAPI is a food and nutrition API providing access to 4.7M+ indexed foods from a worldwide catalog.",
        "termsOfService": "https://www.getdietly.com/api-terms",
        "title": "DietlyAPI",
        "version": "1.0.0",
        "website": "https://www.getdietly.com/api-guide",
        "x-apisguru-categories": [
          "food",
          "open_data"
        ],
        "x-logo": {
          "url": "https://www.getdietly.com/logo.png"
        }
